# Copy to .env (git-ignored) and fill in. Never commit real values.

# development | test | production. Unset means production.
JITAN_ENV=development

JITAN_HTTP_HOST=127.0.0.1
JITAN_HTTP_PORT=8080

# Comma-separated browser origins allowed to call the API (Flutter web dev server).
# Leave empty in production: Nginx serves web apps and API from the same origin.
JITAN_CORS_ORIGINS=http://localhost:5000

JITAN_DB_HOST=
JITAN_DB_PORT=3306
JITAN_DB_NAME=
JITAN_DB_USER=
JITAN_DB_PASSWORD=
# true unless the dev database does not offer TLS
JITAN_DB_SECURE=true

# Signs session tokens. REQUIRED in production, at least 32 random characters,
# e.g. from: openssl rand -base64 48
# Optional in development (a random one is generated; sessions end on restart).
JITAN_SESSION_SECRET=
# Session validity in days (default 30).
JITAN_SESSION_LIFETIME_DAYS=

# Argon2id for password hashing. Defaults: 19456 KiB, 2 iterations, 1 lane
# (OWASP). Benchmark on the target server: dart run tool/bench_argon2.dart
JITAN_ARGON2_MEMORY_KIB=
JITAN_ARGON2_ITERATIONS=
JITAN_ARGON2_PARALLELISM=

# DEVELOPMENT ONLY. The server refuses to start in production if any
# JITAN_DEV_* variable is set.
# tblUser.userID acting as the signed-in user while real login is not built.
JITAN_DEV_USER_ID=
