# Local, disposable Jitan database. Copy to .env (git-ignored) and adjust.
# These values only exist on your machine. Never put IT or production
# credentials here.
JITAN_LOCAL_DB_PORT=3307
JITAN_LOCAL_DB_NAME=jitan_local
JITAN_LOCAL_DB_USER=jitan_local
JITAN_LOCAL_DB_PASSWORD=change-me-local-only
JITAN_LOCAL_DB_ROOT_PASSWORD=change-me-local-root
